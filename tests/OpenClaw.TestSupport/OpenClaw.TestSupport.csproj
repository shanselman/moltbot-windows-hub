<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Shared test-support library: reusable fixtures and builders for the test
      projects (see docs/ARCHITECTURE.md). A plain class library — the local
      Directory.Build.props deliberately skips the shared test-SDK props so this
      does not become a test container.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenClaw.Shared\OpenClaw.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Only the xUnit attribute/extensibility surface, so shared fixtures can define
      capability-gated Fact attributes. This stays a library, not a test container.
    -->
    <PackageReference Include="xunit.extensibility.core" Version="2.9.3" />
  </ItemGroup>

</Project>
