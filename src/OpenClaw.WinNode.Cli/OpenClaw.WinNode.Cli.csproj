<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>winnode</AssemblyName>
    <RootNamespace>OpenClaw.WinNode.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ship the discoverable repository skill next to winnode.exe under the
         legacy sidecar name referenced by CLI help. -->
    <Content Include="..\..\.agents\skills\winnode\SKILL.md">
      <Link>skill.md</Link>
      <TargetPath>skill.md</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenClaw.Shared\OpenClaw.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenClaw.WinNode.Cli.Tests" />
  </ItemGroup>
</Project>
